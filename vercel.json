{
    "rewrites": [
        {
            "source": "/api/health",
            "destination": "/api/fpl-proxy?path=health"
        },
        {
            "source": "/api/wolf-analysis",
            "destination": "/api/gemini-proxy"
        },
        {
            "source": "/api/hello",
            "destination": "/api/hello"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/fpl-proxy?path=$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}