{
    "rewrites": [
        {
            "source": "/api/health",
            "destination": "/api/fpl-proxy?path=health"
        },
        {
            "source": "/api/:match*",
            "destination": "/api/fpl-proxy?path=:match*"
        },
        {
            "source": "/((?!api/.*).*)",
            "destination": "/index.html"
        }
    ]
}